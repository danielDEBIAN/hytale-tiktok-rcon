# Usuario de TikTok (sin el @) que hará el directo
TIKTOK_USERNAME=tu_usuario_tiktok

# Tu nombre de jugador dentro de Hytale (para los comandos {player})
PLAYER_NAME=Daniel

# Configuración del servidor RCON de Hytale (coincide con rcon.properties de HyRCON)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=hytale_rcon_local

# Modo Simulador RCON:
# true  = No requiere servidor Hytale activo; imprime en consola los comandos que se enviarían.
# false = Se conecta por RCON real a tu servidor de Hytale.
MOCK_RCON=true
